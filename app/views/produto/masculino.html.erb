<%= form_with model: @produtos, url: "/produto/masculino", method: :post do |form| %>

    <header>
        <div class="logo">
            <%= image_tag "logo.png", alt: "logo" %>
        </div>

        <nav>
           <a href="/" class="nav-link">Página inicial</a>
        </nav>
        <div class="box-btn-actions">
            <%= button_to "Carrinho", "/carrinho", method: :get, class: "btn-action" %>
            <%= button_to "Entrar", "/user/login", method: :get, class: "btn-action" %>
        </div>
    </header>

    <h1 class="titulo">Mais vendidos</h1>

    <div class="produtos">
        <% @produtos.each do |produto| %>
            <div class="card-produto">
                <%= image_tag produto.imagem, class: "img-produto" %>
                <h3><%= produto.nome %></h3>
                <p class="preco">R$ <%= produto.preco %></p>
                <p class="parcelamento">
                    Até 12x de R$ <%= (produto.preco / 12).round(2) %>
                </p>
                <%= button_to "Adicionar ao carrinho", "/carrinho", method: :get, class: "btn-action", disabled: produto.estoque.to_i.zero? %>
            </div>
        <% end %>
    </div>
<% end %>