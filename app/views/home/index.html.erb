<header class=" flex justify-between align-center p-8 flex-wrap min-h-30 gap-4 bg-white text-black ">
    <div class= "w-auto h-[80px]" "logo">
        <%= image_tag "icone_mayara_modas_fundo_branco.png", alt: "logo",class:"h-full w-auto object-contain"%>
    </div>

    <nav class="flex flex-wrap gap-4 align-center justify-center">
        <a class="ml-8 font-bold hover:text-yellow-500 hover:underline" href="#secao-explorar" class="nav-link">Explorar</a>
        <a class="ml-8 font-bold hover:text-yellow-500 hover:underline" href="/produto/novidades" class="nav-link">Novidades</a>
        <a class="ml-8 font-bold hover:text-yellow-500 hover:underline" href="/produto/feminino" class="nav-link">Feminino</a>
        <a class="ml-8 font-bold hover:text-yellow-500 hover:underline" href="/produto/masculino" class="nav-link">Masculino</a>
        <a class="ml-8 font-bold hover:text-yellow-500 hover:underline" href="/produto/kids" class="nav-link">Kids</a>
    </nav>

    <div class="flex gap-8 ">
        <%= button_to "Carrinho", "/carrinho", method: :get, form_class: "inline", class: "px-6 py-2 border border-black rounded-full cursor-pointer transition-all duration-300 hover:bg-yellow-400 hover:border-yellow-400" %>
        <%= button_to "Entrar", "/user/login", method: :get, form_class: "inline", class: "px-6 py-2 border border-black rounded-full cursor-pointer transition-all duration-300 hover:bg-yellow-400 hover:border-yellow-400" %>
    </div>
</header>

<main class="flex flex-col gap-8">
    <section id="secao-novidades" class="relative w-full">
        <div class="relative w-full h-[850px] overflow-hidden">
            <input type="radio" name="radio-btn" id="radio1" checked class="hidden peer/radio1">
            <input type="radio" name="radio-btn" id="radio2" class="hidden peer/radio2">
            <input type="radio" name="radio-btn" id="radio3" class="hidden peer/radio3">

            <div class="flex w-[300%] h-full transition-transform duration-700has-[#radio2:checked]:-translate-x-[33.333%]has-[#radio3:checked]:-translate-x-[66.666%]">
                <div class="relative w-1/3 h-full flex-shrink-0">
                    <%= image_tag "hero.png", alt: "principal", class: "w-full h-full object-cover"  %>
                    <div class=""absolute inset-0 flex flex-col justify-center items-start gap-4 p-12 bg-black/30 text-white">
                        <h2 class="text-4xl font-bold">Nova Coleção</h2>
                        <p class="text-lg">Descubra os lançamentos da temporada</p>
                        <%= link_to "Ver agora", "/produto/novidades", class: "px-6 py-2 bg-yellow-500 rounded-full font-bold hover:bg-yellow-400 transition-colors" %>
                    </div>
                </div>

                <div class="relative w-1/3 h-full flex-shrink-0">
                    <%= image_tag "novidades-women.png", alt: "secundário", class: "w-full h-full object-cover" %>
                    <div class="absolute inset-0 flex flex-col justify-center items-start gap-4 p-12 bg-black/30 text-white">
                        <h2 class="text-4xl font-bold">Feminino</h2>
                        <p class="text-lg">Estilo e conforto para todos os momentos</p>
                        <%= link_to "Explorar", "/produto/feminino", class: "px-6 py-2 bg-yellow-500 rounded-full font-bold hover:bg-yellow-400 transition-colors" %>
                    </div>
                </div>

                <div class="relative w-1/3 h-full flex-shrink-0">
                    <%= image_tag "novidades-men.png", alt: "terceiro", class: "w-full h-full object-cover" %>
                    <div class="absolute inset-0 flex flex-col justify-center items-start gap-4 p-12 bg-black/30 text-white">
                        <h2 class="text-4xl font-bold">Masculino</h2>
                        <p class="text-lg">Peças essenciais com design moderno</p>
                        <%= link_to "Ver coleção", "/produto/masculino", class: "px-6 py-2 bg-yellow-500 rounded-full font-bold hover:bg-yellow-400 transition-colors" %>
                    </div>
                </div>
            </div>

            <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2 z-10">
                <label for="radio1" class="w-3 h-3 rounded-full bg-white/60 cursor-pointer peer-checked/r1:bg-yellow-500"></label>
                <label for="radio2" class="w-3 h-3 rounded-full bg-white/60 cursor-pointer peer-checked/r2:bg-yellow-500"></label>
                <label for="radio3" class="w-3 h-3 rounded-full bg-white/60 cursor-pointer peer-checked/r3:bg-yellow-500"></label>
            </div>
        </div>
    </section>

    <section id="secao-explorar" class="flex flex-col items-center gap-2 px-8">
        <h2 class="text-3xl font-bold">Explorar</h2>
        <p class="text-gray-500 mb-8">Escolha uma categoria e encontre o look ideal</p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-16 w-full max-w-6xl">
            <a href="/produto/feminino" class="group flex flex-col items-center gap-2 rounded-xl overflow-hidden shadow hover:shadow-lg transition-shadow">
                <%= image_tag "vestido-azul.png", alt: "Feminino", class: "w-full h-150 object-cover group-hover:scale-105 transition-transform duration-300" %>
                <h3 class="text-xl font-bold mt-2">Feminino</h3>
                <span class="text-gray-500 text-sm pb-4">Vestidos, blusas e muito mais</span>
            </a>

            <a href="/produto/masculino" class="group flex flex-col items-center gap-2 rounded-xl overflow-hidden shadow hover:shadow-lg transition-shadow">
                <%= image_tag "polo-verde-oliva.png", alt: "Masculino",class: "w-full h-150 object-cover group-hover:scale-105 transition-transform duration-300" %>
                <h3 class="text-xl font-bold mt-2">Masculino</h3>
                <span class="text-gray-500 text-sm pb-4">Camisetas, calças e acessórios</span>
            </a>

            <a href="/produto/kids" class="group flex flex-col items-center gap-2 rounded-xl overflow-hidden shadow hover:shadow-lg transition-shadow">
                <%= image_tag "menina-capa.png", alt: "Kids", class: "w-full h-150 object-cover group-hover:scale-105 transition-transform duration-300" %>
                <h3 class="text-xl font-bold mt-2">Kids</h3>
                <span class="text-gray-500 text-sm pb-4">Moda confortável para crianças</span>
            </a>
        </div>
    </section>

    <section id="secao-destaques" class="flex flex-col items-center gap-4 px-8 pb-16">
        <h2 class="font-bold mt-2">Produtos em Destaque</h2>
        <p class="text-gray-500 text-sm">Selecionados especialmente para você</p>

        <div class="grid grid-cols-2 items-center sm:grid-cols-3 lg:grid-cols-3 gap-6 w-full max-w-6xl">
            <% @destaques.each do |produto| %>
                <article class="flex flex-col gap-4 rounded-xl overflow-hidden shadow hover:shadow-lg transition-shadow p-3">
                    <%= image_tag produto.imagem, alt: produto.nome, class: "w-full h-100 object-cover rounded-lg" %>
                    <h4 class="font-bold mt-2"><%= produto.nome %></h4>
                    <p class="font-bold text-lg">R$ <%= number_with_precision(produto.preco, precision: 2, delimiter: ".", separator: ",") %></p>
                    <p class="text-gray-500 text-sm"><%= produto.categoria.capitalize %></p>
                    <%= link_to "Ver Produto", show_produto_path(produto), class: "mt-2 text-center px-4 py-2 bg-black text-white rounded-full font-bold hover:bg-yellow-400 hover:text-black transition-colors"  %>
                </article>
            <% end %>
        </div>
    </section>
</main>

<footer class="flex flex-col items-center gap-2 py-8 bg-white text-black">
    <div class="w-auto h-[100px]">
        <%= image_tag "icone_mayara_modas_fundo_branco.png", alt: "logo" ,class: "h-full w-auto object-contain" %>
    </div>
    <p class="text-sm text-gray-400">&copy; <%= Date.current.year %> Mayara Modas. Todos os direitos reservados.</p>
</footer>